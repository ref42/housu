  "semanticTokenColors": {
    "namespace": "#a6b8ce",
    "class": "#a6b8ce",
    "interface": "#a6b8ce",
    "struct": "#a6b8ce",
    "enum": "#a6b8ce",
    "enumMember": "#a6b8ce",
    "type": "#a6b8ce",
    "typeParameter": "#a6b8ce",
    "function": "#d3d1cc",
    "method": "#d3d1cc",
    "macro": "#a6b8ce",
    "decorator": "#a6b8ce",
    "label": "#d7b87b",
    "property": "#d3d1cc",
    "variable": "#d3d1cc",
    "parameter": "#d3d1cc",
    "keyword": "#d7b87b",
    "modifier": "#d7b87b",
    "operator": "#d7b87b",
    "string": "#d3d1cc",
    "number": "#a6b8ce",
    "regexp": "#a6b8ce",
    "punctuation": "#d3d1cc",
    "comment": {
      "foreground": "#d3d1cc",
      "italic": false
    },
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.modifier",
        "storage.type",
        "keyword.operator.new",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#d7b87b",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#d7b87b",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Constants and numbers",
      "scope": [
        "constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants",
      "scope": [
        "constant.language",
        "variable.language"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "self and super",
      "scope": [
        "variable.language.self",
        "variable.language.super",
        "variable.language.this",
        "variable.language.special.self",
        "variable.language.special.cls",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#d7b87b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attributes and macros",
      "scope": [
        "meta.attribute.rust",
        "entity.name.function.macro",
        "entity.name.type.macro",
        "entity.name.function.decorator",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "support.type.julia",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Namespaces and modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "support.other.namespace",
        "variable.other.namespace"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function",
        "entity.name.function.constructor",
        "support.function",
        "support.function.any-method",
        "support.function.builtin",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties and keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables and parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.group",
        "punctuation.section.block",
        "punctuation.section.group",
        "punctuation.brackets.curly",
        "punctuation.brackets.round",
        "punctuation.brackets.square"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e69b9b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#d3d1cc",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Rust metavariable",
      "scope": [
        "variable.other.metavariable.name"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust metavariable type",
      "scope": [
        "variable.other.metavariable.specifier"
      ],
      "settings": {
        "foreground": "#a6b8ce",
        "fontStyle": ""
      }
    },
    {
      "name": "Rust Result",
      "scope": [
        "entity.name.type.result",
